# Route all requests through index.php-style pages
# and protect sensitive directories from direct access.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Serve the generated sitemap at the conventional path
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Block access to hidden files (.env, .git, etc.)
    RewriteRule (^\.|/\.) - [F]
</IfModule>

# Friendly error pages
ErrorDocument 404 /404.php

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block direct access to hidden files as a fallback
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
