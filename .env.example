# =============================================================
# Ikizere Funds — Environment Configuration
# =============================================================
# Copy this file to .env and fill in values for local dev:
#   cp .env.example .env
#
# On Railway: set variables in the dashboard instead. Real
# environment variables always take precedence over this file,
# so a leftover .env can never override your platform config.
# =============================================================

# ---------- Database ----------
# On Railway these are detected automatically from the MySQL
# plugin (MYSQLHOST / MYSQLPORT / MYSQL_DATABASE / MYSQL_USER /
# MYSQL_PASSWORD, or MYSQL_URL). Leave them unset there.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ikizere_funds
DB_USER=root
DB_PASS=

# ---------- Application ----------
# Leave APP_URL unset on Railway — it is detected from the request.
APP_URL=http://localhost:8000

# ---------- Debug ----------
# 1 shows PHP errors and stack traces. NEVER set this to 1 in production.
APP_DEBUG=0

# =============================================================
# RAILWAY: zero-config deployment
# =============================================================
# 1. Connect your GitHub repo on railway.app
# 2. New → Database → Add MySQL
# 3. Set ADMIN_PASS below, then deploy
# 4. Settings → Networking → Generate Domain
# 5. Add a volume at /var/www/html/assets/uploads so member
#    photos and documents survive redeploys
#
# The app creates the database, imports the schema, applies
# migrations and seeds the first login on every boot. The setup
# script is idempotent — redeploying never touches existing data.
# =============================================================

# ---------- First-run admin account ----------
# Set ADMIN_PASS before your first deploy. If you leave it unset
# the app boots with the published default "President@123" and
# prints a warning in the deploy logs.
# ADMIN_USER=president
# ADMIN_PASS=ChangeThisToSomethingStrong
# ADMIN_NAME=Club President
# ADMIN_EMAIL=you@example.com
# ADMIN_PHONE=+250700000000

# Set to 0 to skip the demo vicepresident / secretary /
# accountant / auditor logins and create those users by hand.
# SEED_ROLE_ACCOUNTS=0

# ---------- Email notifications (optional) ----------
# Savings reminders, loan updates and meeting notices always appear
# in each member's in-app inbox. Fill these in to ALSO deliver them
# by email. Leave them blank and email is skipped cleanly — nothing
# breaks, and notifications stay visible in the app.
#
# Gmail/Outlook require an APP PASSWORD, not your normal password.
# Verify your settings with:  php scripts/test_email.php you@example.com
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ikizerefunds@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=tls              # tls (port 587, default) | ssl (port 465) | none
# SMTP_FROM=ikizerefunds@gmail.com
# SMTP_FROM_NAME=IKIZERE FUNDS Club
# SMTP_TIMEOUT=15

# ---------- SMS notifications (optional) ----------
# Configure ONE provider. Africa's Talking has local Rwandan rates;
# Twilio is here if you already use it. Numbers may be stored the
# local way (07XXXXXXXX) — they are converted to +250... for you.
#
# Verify with:  php scripts/test_sms.php 0790974685
# Tip: AT_USERNAME=sandbox with a sandbox key costs nothing to test.

# --- Africa's Talking ---
# AT_USERNAME=your_africastalking_username
# AT_API_KEY=your_api_key
# AT_SENDER_ID=IKIZERE        # optional; approved sender ID or shortcode

# --- Twilio (alternative) ---
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your_auth_token
# TWILIO_FROM=+15551234567

# Set to 1 to text members who have a phone number but no email
# address. Off by default because SMS costs money per message.
# SMS_FALLBACK=1
# SMS_PROVIDER=africastalking   # auto-detected from the keys above
# SMS_TIMEOUT=15
